# never deploy python bytecode caches that appear next to bin scripts
**/__pycache__

# feature flags come from ~/.config/chezmoi/chezmoi.toml [data]
{{ if not (dig "features" "work" false .) }}
.config/zsh/work.zsh
{{ end }}
{{ if not .features.streaming }}
.config/stream/**
.config/sunshine/**
.config/systemd/user/app-dev.lizardbyte.app.Sunshine.service.d/**
.config/hypr/monitors-runtime.conf
.local/bin/stream
{{ end }}
{{ if dig "features" "headless" false . }}
# headless server: skip everything graphical, keep the terminal stack
.config/DankMaterialShell/**
.config/hypr/**
.config/kitty/**
.config/gtk-3.0/**
.config/gtk-4.0/**
.gtkrc-2.0
.config/qt6ct/**
.config/mimeapps.list
.config/stream/**
.config/sunshine/**
.XCompose
.face
.gnupg/gpg-agent.conf
.config/environment.d/**
.local/bin/presence
.local/bin/cursor-drift
.local/bin/screenprivacy
.local/bin/ws-move
.local/bin/dms-bar-setup
.local/bin/dms-plugins-setup
.local/share/wallpapers/**
.local/state/DankMaterialShell/**
{{ end }}
